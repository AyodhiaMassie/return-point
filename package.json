{
  "name": "returnpoint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first Chrome side panel for picking up where you left off.",
  "scripts": {
    "build": "npm run typecheck && vite build && node scripts/verify-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "vite --host 127.0.0.1 --port 5173 --strictPort --open /demo/"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
